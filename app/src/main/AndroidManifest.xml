<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.camera.front" android:required="false" />

    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Voice assistant and the microphone for web pages in Air (asked when first used). -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Only for the update check and the Pro plan settings (camera images never leave the phone). -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Updates downloaded inside the app (GitHub releases) are handed to Android's installer. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />
    <!-- Built-in Cloud PC: keeps installs/commands running with the screen off. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- Ubuntu Mode: start the Ubuntu desktop inside Termux -->
    <uses-permission android:name="com.termux.permission.RUN_COMMAND" />

    <!-- PC mode lists installed apps to start them from the start menu. -->
    <queries>
        <package android:name="com.termux" />
        <package android:name="com.termux.x11" />
        <!-- "Edit on the phone": CapCut first when it is installed (else the share sheet). -->
        <package android:name="com.lemon.lvoverseas" />
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- The voice assistant: the phone's speech recognition and text-to-speech. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
        <intent>
            <action android:name="android.intent.action.TTS_SERVICE" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:icon="@mipmap/brand_aircursor"
        android:roundIcon="@mipmap/brand_aircursor"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.Material.Light.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".ubuntu.UbuntuLaunchActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:icon="@mipmap/brand_pc"
            android:label="@string/ubuntu_pc_label"
            android:roundIcon="@mipmap/brand_pc"
            android:taskAffinity="com.aircursor.ubuntu"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>


        <activity
            android:name=".cloudpc.CloudPcDesktopActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="false"
            android:label="@string/ubuntu_pc_label"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:taskAffinity="com.aircursor.cloudpc"
            android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <!-- This phone as keyboard and touchpad for AirCursor PC on another phone. -->
        <activity
            android:name=".cloudpc.RemotePadActivity"
            android:exported="false"
            android:label="Keyboard &amp; touchpad"
            android:theme="@android:style/Theme.Material.NoActionBar"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden"
            android:windowSoftInputMode="adjustResize|stateHidden" />
        <!-- Share sheet → "AirCursor PC": files from any app go straight into the PC. -->
        <activity
            android:name=".cloudpc.ShareToPcActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:label="@string/ubuntu_pc_label"
            android:taskAffinity=""
            android:theme="@android:style/Theme.Material.Dialog.NoActionBar">
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="*/*" />
            </intent-filter>
        </activity>

        <service
            android:name=".cloudpc.CloudPcService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Installs and runs a Linux desktop (Ubuntu via proot) that the user started" />
        </service>

        <service
            android:name=".ubuntu.CloudPcTileService"
            android:exported="true"
            android:icon="@drawable/ic_ui_desktop"
            android:label="@string/ubuntu_pc_label"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.pcfiles"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/pc_files" />
        </provider>
    </application>
</manifest>
