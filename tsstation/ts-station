#!/bin/bash
# TS Station launcher: starts the local server and opens the interface full screen.
. /tmp/cloudpc-session.env 2>/dev/null
DIR=$(dirname "$(readlink -f "$0")")
pkill -f "python3 $DIR/server.py$" 2>/dev/null
rm -f /tmp/ts-station.url
# Shown in Air (the phone's own browser engine, over the PC) when it is there: much smoother.
IN_AIR=0
command -v cloudpc-air >/dev/null 2>&1 && IN_AIR=1
TS_IN_AIR=$IN_AIR python3 "$DIR/server.py" > /tmp/ts-station.url 2> /tmp/ts-station.log &
URL=""
for i in $(seq 1 60); do
    URL=$(head -n 1 /tmp/ts-station.url 2>/dev/null)
    [ -n "$URL" ] && break
    sleep 0.1
done
if [ -z "$URL" ]; then
    zenity --error --no-markup --text="TS Station could not start.

$(tail -n 5 /tmp/ts-station.log)" 2>/dev/null
    exit 1
fi
if [ "$IN_AIR" = 1 ]; then
    # Its own full-screen app window in Air (no tabs or address bar), like a console.
    command -v cloudpc-app >/dev/null 2>&1 && exec cloudpc-app tsstation max "TS Station" "$URL"
    exec cloudpc-air "$URL"
fi
if [ -x /usr/bin/brave-browser-stable ]; then
    exec cloudpc-launch brave-browser.desktop /usr/bin/brave-browser-stable --app="$URL" --start-fullscreen
fi
exec firefox --kiosk --new-window "$URL"
